{
  "version": 2,

  "rewrites": [
    {
      "source": "/api/bitable/:path*",
      "destination": "/api/[...path]"
    }
  ],
  "functions": {
    "api/transcribe.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/transcribe/status.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/dashscope/chat/completions.js": {
      "memory": 512,
      "maxDuration": 60
    },
    "api/feishu/token.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/[...path].js": {
      "memory": 256,
      "maxDuration": 30
    }
  }
}
